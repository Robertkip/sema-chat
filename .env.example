# Sema needs ONE of the following. See lib/chat-config.ts.

# Option A — talk to Mistral directly. Preferred; this is what the app uses
# when the variable is set. https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Option B — route through the Vercel AI Gateway instead. On a Vercel
# deployment this works via OIDC with no value here, but the gateway requires
# a card on file before it will release its free credits.
# AI_GATEWAY_API_KEY=
